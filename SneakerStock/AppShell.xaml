<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SneakerStock.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:SneakerStock.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="SneakerStock">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Zapatillas"
        ContentTemplate="{DataTemplate views:SneakersPage}"
        Route="SneakersPage" />

</Shell>