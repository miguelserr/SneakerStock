<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SneakerStock.Models"
             x:Class="SneakerStock.Views.SneakersPage"
             Title="Zapatillas"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="20" RowSpacing="18">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="Inventario"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Primary}" />
            <Label Text="Zapatillas disponibles"
                   FontSize="14"
                   TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding TotalModels}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Modelos"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding TotalPairs}"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />
                    <Label Text="Pares en stock"
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Sneakers}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Sneaker">

                    <Border Style="{StaticResource CardBorder}"
                            Padding="14"
                            Margin="0,0,0,12">
                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="14">

                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource FieldBackground}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 16"
                                    HeightRequest="100"
                                    Padding="8">
                                <Image Source="{Binding ImagePath}"
                                       Aspect="AspectFit"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="4">
                                <Label Text="{Binding Model}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding Size, StringFormat='Talla {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                                <Label Text="{Binding Price, StringFormat='$ {0:N0}'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}" />

                                <HorizontalStackLayout Spacing="8" Margin="0,6,0,0">
                                    <Button Text="−"
                                            Style="{StaticResource StepButton}"
                                            Clicked="OnDecreaseClicked" />
                                    <Button Text="+"
                                            Style="{StaticResource StepButtonDark}"
                                            Clicked="OnIncreaseClicked" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    VerticalOptions="Start"
                                    BackgroundColor="{StaticResource Primary}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="10,5">
                                <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>

                        </Grid>
                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3"
                Text="+ NUEVA ZAPATILLA"
                Style="{StaticResource PrimaryButton}"
                Clicked="OnAddClicked" />

    </Grid>
</ContentPage>