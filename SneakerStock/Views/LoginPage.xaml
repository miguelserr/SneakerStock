<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SneakerStock.Views.LoginPage"
             Title="Login"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource AppBackground}">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="24" VerticalOptions="Center">

            <VerticalStackLayout Spacing="6">
                <Label Text="SNEAKER STOCK"
                       FontSize="32"
                       FontAttributes="Bold"
                       CharacterSpacing="2"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource Primary}" />
                <Label Text="Gestión de inventario de zapatillas"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}" Padding="24">
                <VerticalStackLayout Spacing="16">

                    <Label Text="Iniciar sesión"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Border Style="{StaticResource FieldBorder}">
                        <Grid ColumnDefinitions="32,*" ColumnSpacing="8">
                            <Image Source="ic_user.png"
                                   WidthRequest="22" HeightRequest="22"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="UserEntry"
                                   Grid.Column="1"
                                   Placeholder="Usuario"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   TextColor="{StaticResource Primary}"
                                   BackgroundColor="Transparent"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FieldBorder}"
                            Padding="14,0,24,0">
                        <Grid ColumnDefinitions="32,*,36" ColumnSpacing="8">
                            <Image Source="ic_lock.png"
                                   WidthRequest="22" HeightRequest="22"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Entry x:Name="PasswordEntry"
                                   Grid.Column="1"
                                   Placeholder="Contraseña"
                                   PlaceholderColor="{StaticResource TextSecondary}"
                                   TextColor="{StaticResource Primary}"
                                   BackgroundColor="Transparent"
                                   IsPassword="True"
                                   VerticalOptions="Center" />
                            <ImageButton x:Name="EyeButton"
                                         Grid.Column="2"
                                         Source="ic_eye.png"
                                         WidthRequest="22" HeightRequest="22"
                                         Padding="0"
                                         Aspect="AspectFit"
                                         BackgroundColor="Transparent"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Border>

                    <Button Text="INGRESAR"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,8,0,0"
                            Clicked="OnLoginClicked" />
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                <Label Text="¿No tienes cuenta?"
                       FontSize="14"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="Regístrate"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>